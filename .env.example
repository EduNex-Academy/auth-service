# Keycloak Configuration
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=edunex-platform
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_ID=edunex-platform-client
KEYCLOAK_CLIENT_SECRET=client-secret-placeholder

KEYCLOAK_ADMIN_REDIRECT_URI=http://localhost:3001/auth/callback
KEYCLOAK_STUDENT_REDIRECT_URI=http://localhost:3000/auth/callback
KEYCLOAK_INSTRUCTOR_REDIRECT_URI=http://localhost:3000/auth/callback

KEYCLOAK_ADMIN_PASSWORD_RESET_REDIRECT_URI=http://localhost:3001/auth/forgot-password
KEYCLOAK_STUDENT_PASSWORD_RESET_REDIRECT_URI=http://localhost:3000/auth/forgot-password
KEYCLOAK_INSTRUCTOR_PASSWORD_RESET_REDIRECT_URI=http://localhost:3000/auth/forgot-password

# Application Server Configuration
SERVER_PORT=8081

# Logging Levels
LOG_LEVEL_SECURITY=DEBUG
LOG_LEVEL_KEYCLOAK=DEBUG
LOG_LEVEL_SPRING=INFO
